# Caption API base for <abol-player caption-api>.
# Prefer the same-origin proxy (works on Vercel HTTPS):
VITE_ABOL_API_ORIGIN=/abol-proxy
# Or call EC2 directly (HTTP only — blocked from HTTPS pages):
# VITE_ABOL_API_ORIGIN=http://16.16.124.190

# generate-captions value for <abol-player> (am om ti aa)
VITE_GENERATE_CAPTIONS=am om ti aa

# Dev proxies (Vite only — not exposed to the browser bundle):
# Local Compose (recommended for original AssemblyAI Listen audio):
ABOL_API_PROXY_TARGET=http://127.0.0.1:8787
ABOL_MINIO_ORIGIN=http://127.0.0.1:9000
# Or remote EC2 API (MinIO must be reachable; signatures need Host localhost:9000):
# ABOL_API_PROXY_TARGET=http://16.16.124.190
# ABOL_MINIO_ORIGIN=http://127.0.0.1:9000
#
# Vercel: vercel.json rewrites /api and /abol-proxy to EC2. Expose MinIO on the
# API host with Caddy:
#   handle_path /abol-minio/* {
#     reverse_proxy 127.0.0.1:9000 {
#       header_up Host localhost:9000
#     }
#   }
